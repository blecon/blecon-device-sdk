    default ""

config BLECON_MEMFAULT_SOFTWARE_TYPE
    string "Software Type"

config BLECON_MEMFAULT_DEFAULT_DEVICE_INFO
    bool "Enable default memfault_platform_get_device_info() implementation"
    default y

endif

